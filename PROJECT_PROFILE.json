{
  "projectId": "scms",
  "projectName": "Semantic CMS",
  "profileVersion": "0.5.3",
  "profileStatus": "provisional",
  "intentRef": "PROJECT_INTENT.md",
  "authorityRef": "docs/AUTHORITY_MODEL.md",
  "bindingsRef": "bindings/PROJECT_BINDINGS.yaml",
  "contextSourcesRef": "CONTEXT_SOURCES.json",
  "designRef": "DESIGN.md",
  "operatingMode": "existing",
  "executionProvider": {
    "name": "local-files",
    "workGraph": "work/ directory: GRAPH.md register plus one markdown issue contract per item (SCMS-NNN.md)",
    "repository": "local filesystem at this directory; version control recommended but not yet initialized",
    "dispatch": "interactive agent session under owner direction",
    "verification": "scripts/validate-bootstrap.py --check-context; per-item evidence in records/evidence.jsonl",
    "protection": "acp-gateway",
    "observability": null
  },
  "serviceOperations": [
    {
      "service": "acp-gateway",
      "interface": "official-api",
      "allowedEnvironments": [
        "local",
        "staging",
        "production"
      ],
      "allowedEffects": [
        "read",
        "authorize",
        "report"
      ],
      "protectedEffects": [
        "policy.modify",
        "credential.modify"
      ]
    }
  ],
  "authorityBindings": {
    "projectMutation": "agent-under-owner-direction",
    "qualification": "project.owner",
    "promotion": "project.owner",
    "productionOperation": "project.owner",
    "deviation": "project.owner"
  },
  "protectedActions": [
    "external-publication",
    "production-deployment",
    "spending",
    "destructive-migration",
    "credential-or-iam-change",
    "authoritative-intent-change",
    "external-communication"
  ],
  "autonomy": {
    "frontierReselection": true,
    "continueOnLocalizedBlocker": true,
    "maxConcurrentMutationClaims": 2,
    "humanEscalation": "decision-boundaries-only",
    "protectedEffectsRequireAcpDecision": true
  },
  "contextPolicy": {
    "compiledContextRequired": true,
    "generatedContextNormative": false,
    "requireContextLock": true,
    "refreshOnMaterialSourceChange": true
  },
  "profiles": [],
  "formalResourceManifest": "FORMAL_RESOURCE_MANIFEST.json",
  "authorizationProvider": {
    "name": "acp-gateway",
    "status": "bound",
    "integrationRef": "docs/ACP_INTEGRATION.md",
    "decisionSchema": "schemas/acp-decision.schema.json",
    "actionMap": "contracts/acp-protected-effects.yaml",
    "gatewayUrlEnv": "ACP_GATEWAY_URL",
    "gatewayTokenEnv": "ACP_GATEWAY_TOKEN",
    "boardEnvFile": ".agents/board.env",
    "board": {
      "owner": null,
      "number": null
    },
    "authorizedEffectClassesMinimum": "E2",
    "failClosed": true,
    "reportOnSessionStart": true,
    "reportBeforeProtectedEffect": true,
    "checkScript": "scripts/acp-check.py",
    "clientScript": "scripts/acp.py",
    "externalEnforcement": "append-only records/*.jsonl convention plus declared protected effects; store-level grant enforcement arrives with the Canon plane"
  }
}
