__pycache__/
.DS_Store
# The user-global excludes file (~/.config/git/ignore) treats .agents/ and
# AGENTS.md as local tooling. In an FPB project they are REQUIRED canonical
# artifacts: AGENTS.md is the operating contract, .agents/ is the compiled
# context whose digest the B1/C0 gates verify. Re-include both, or CI checks
# a tree the author never had. (NR-scms-002)
!.agents/
!.agents/**
!AGENTS.md
.DS_Store

# Editor working data: the owner's edits and P7 observations live outside the
# repository. This repo does not vendor the content it manages, and that
# includes revisions made through the editor.
.scms-data/
impl/editor/web/data.json
